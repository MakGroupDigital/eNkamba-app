{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "eNkamba",
  "version": "1.3.4",
  "identifier": "io.enkamba.app",
  "build": {
    "frontendDist": "../tauri-dist",
    "devUrl": "http://localhost:9002",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [
      {
        "url": "https://www.enkamba.io",
        "title": "eNkamba",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24,
      "versionCode": 10,
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
