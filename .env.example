# Groq API for AI Chat
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here

# Google OAuth Client IDs (SAFE TO COMMIT - Public by design)
# Get from: https://console.cloud.google.com/apis/credentials
# These are public and protected by domain/package restrictions
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# Tavily Web Search API (for real-time web search)
TAVILY_API_KEY=your_tavily_api_key_here

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

# reCAPTCHA
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain_here
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here
NEXT_PUBLIC_FIREBASE_DATABASE_URL=your_firebase_database_url_here
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_web_push_vapid_key_here

# Server-side Firebase credentials (required for add-funds route)
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain_here
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here
FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id_here
FIREBASE_APP_ID=your_firebase_app_id_here

# Firebase Cloud Functions Region
FIREBASE_FUNCTION_REGION=us-central1

# WebRTC ICE servers (JSON array). Add your TURN servers here for distant audio/video calls.
# Example:
# NEXT_PUBLIC_WEBRTC_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:your-turn-server:3478"],"username":"user","credential":"pass"}]
NEXT_PUBLIC_WEBRTC_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302","stun:stun1.l.google.com:19302"]}]

# Alternative plus simple pour un TURN auto-heberge (coturn).
# Si NEXT_PUBLIC_WEBRTC_ICE_SERVERS est vide, le client construit automatiquement STUN + TURN avec ces variables.
NEXT_PUBLIC_WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302
NEXT_PUBLIC_WEBRTC_TURN_HOST=turn.votre-domaine.com
NEXT_PUBLIC_WEBRTC_TURN_PORT=3478
# Optionnel pour TLS sur 5349
NEXT_PUBLIC_WEBRTC_TURNS_PORT=5349
NEXT_PUBLIC_WEBRTC_TURN_USERNAME=enkamba
NEXT_PUBLIC_WEBRTC_TURN_PASSWORD=changez-ce-mot-de-passe

# Variantes encodees pour les plateformes de prod si vous ne voulez pas exposer les valeurs en clair dans le repo.
NEXT_PUBLIC_WEBRTC_STUN_URLS_ENCODED=
NEXT_PUBLIC_WEBRTC_TURN_HOST_ENCODED=
NEXT_PUBLIC_WEBRTC_TURN_PORT_ENCODED=
NEXT_PUBLIC_WEBRTC_TURNS_PORT_ENCODED=
NEXT_PUBLIC_WEBRTC_TURN_USERNAME_ENCODED=
NEXT_PUBLIC_WEBRTC_TURN_PASSWORD_ENCODED=

# Supabase (optionnel, mode redondance realtime)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cloudinary Configuration (for Stories media upload)
# Get these from: https://console.cloudinary.com/settings/api-keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset

# Option 1: Use CLOUDINARY_URL (recommended, single variable)
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Encode in Base64 to avoid GitHub secret scanning
CLOUDINARY_URL_ENCODED=your_base64_encoded_cloudinary_url

# Option 2: Use separate variables (alternative)
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

