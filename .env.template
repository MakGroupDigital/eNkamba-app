# Template pour les variables d'environnement Enkamba
# Copie ce fichier vers .env.local et remplis les valeurs

# Configuration pour l'IA Groq (GRATUIT et RAPIDE)
GROQ_API_KEY=your_groq_api_key_here

# Configuration pour l'IA Gemini (BACKUP)
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here

# reCAPTCHA v2
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
NEXT_PUBLIC_FIREBASE_DATABASE_URL=your_firebase_database_url
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Firebase Cloud Functions Region
FIREBASE_FUNCTION_REGION=us-central1

# Firebase Admin SDK (for server-side operations)
FIREBASE_PROJECT_ID=your_firebase_project_id

# Supabase Configuration (ENCODED pour GitHub)
NEXT_PUBLIC_SUPABASE_URL_ENCODED=your_base64_encoded_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY_ENCODED=your_base64_encoded_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY_ENCODED=your_base64_encoded_supabase_service_role_key

# Firebase Admin SDK (ENCODED pour GitHub)
FIREBASE_CLIENT_EMAIL_ENCODED=your_base64_encoded_firebase_client_email
FIREBASE_PRIVATE_KEY_ENCODED=your_base64_encoded_firebase_private_key

# Cloudinary Configuration (ENCODED pour GitHub)
# Cloud Name: dy73hzkpm
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME_ENCODED=ZHk3M2h6a3Bt
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET_ENCODED=c3Rvcmllc19wcmVzZXQ=

# Cloudinary URL (REQUIRED for server-side uploads)
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Encode en Base64: echo -n "cloudinary://YOUR_API_KEY:YOUR_API_SECRET@dy73hzkpm" | base64
CLOUDINARY_URL_ENCODED=your_base64_encoded_cloudinary_url
